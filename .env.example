# Clave del API de Claude (si falta, FinBot usa la heurística local)
ANTHROPIC_API_KEY=
# Modelo a usar para la extracción; por defecto claude-opus-5
FINBOT_MODEL=

# Bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
# Secreto opcional que Telegram envía en x-telegram-bot-api-secret-token
TELEGRAM_WEBHOOK_SECRET=

# Moneda
FINBOT_CURRENCY=COP

# Base de datos.
# En producción (Vercel) es obligatorio Turso: el disco es de solo lectura y
# efímero, así que un archivo SQLite local no sobrevive.
#   turso db create finbot && turso db show finbot --url && turso db tokens create finbot
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# En local, si no defines TURSO_DATABASE_URL, se usa este archivo.
FINBOT_DB=./data/finbot.db
